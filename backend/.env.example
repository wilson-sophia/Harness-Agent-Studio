# Copy to backend/.env and fill in locally. Never commit the real file.
APP_ORIGIN=http://127.0.0.1:5173
LISTEN_ADDR=127.0.0.1:8080
DATA_FILE=data/app.json
APP_ENCRYPTION_KEY=
HARNESS_API_BASE=https://app.harness.io/gateway

# Optional: OpenAI-compatible model, limited to api.deepseek.com or api.openai.com
MODEL_API_URL=https://api.deepseek.com/chat/completions
MODEL_NAME=deepseek-chat
MODEL_API_KEY=

# Optional: existing trusted demo pipeline. No arbitrary repository execution.
DEMO_REPOSITORY=
DEMO_ACCOUNT_ID=
DEMO_ORG_ID=
DEMO_PROJECT_ID=
DEMO_PIPELINE_ID=
DEMO_API_TOKEN=
